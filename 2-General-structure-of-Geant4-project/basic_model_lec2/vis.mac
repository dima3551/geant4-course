/vis/open OGL 600x600-0+0

/vis/viewer/set/autoRefresh false
/vis/verbose errors

# Draw geometry:
/vis/drawVolume

# Specify view angle:
/vis/viewer/set/viewpointVector -1 0 0
/vis/viewer/set/lightsVector -1 0 0

# Specify style (surface, wireframe, auxiliary edges,...)
/vis/viewer/set/style wireframe
/vis/viewer/set/auxiliaryEdge false
/vis/viewer/set/lineSegmentsPerCircle 100
#
# Draw smooth trajectories at end of event, showing trajectory points
# as markers 2 pixels wide:
/vis/scene/add/trajectories smooth


#Set up color of different particles
/vis/modeling/trajectories/create/drawByParticleID

/vis/modeling/trajectories/drawByParticleID-0/set Ti50 yellow
/vis/modeling/trajectories/drawByParticleID-0/set Pu242 blue
/vis/modeling/trajectories/drawByParticleID-0/set O16 red

#Need this for multithreading mode
/vis/multithreading/maxEventQueueSize 100


# To superimpose all of the events from a given run:
/vis/scene/endOfEventAction accumulate 100

#Draw magnetic field, number sets inverse of density of arrows
#/vis/scene/add/magneticField 100

#
# Axes, scale, etc.
#/vis/scene/add/scale   # Simple scale line
/vis/scene/add/axes    # Simple axes: x=red, y=green, z=blue.
/vis/scene/add/eventID # Drawn at end of event
